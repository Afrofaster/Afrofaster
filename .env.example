# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (local Postgres, Supabase, Neon…).
# The role MUST NOT have BYPASSRLS — Row Level Security is how user data is isolated.
DATABASE_URL=postgres://lia:lia@localhost:5432/lia_dev
# Used only by the integration/E2E test suites.
TEST_DATABASE_URL=postgres://lia:lia@localhost:5432/lia_test

# ─── Auth ────────────────────────────────────────────────────────────────────
# Public base URL (used for Origin checks and absolute links).
APP_URL=http://localhost:3000
# "true" allows creating new accounts from /signup. When false, signup is only
# allowed while the database has zero users (first-run bootstrap for Jhony).
ALLOW_SIGNUP=false

# ─── AI (server-side only — never prefix with NEXT_PUBLIC_) ─────────────────
# LÍA works without a key (deterministic router + templates). With a key she
# gains LLM classification, tool-calling and natural phrasing.
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-5.5
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_VOICE=gpt-realtime-2
# Voice pipeline (record → transcribe → LÍA → spoken reply).
OPENAI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
OPENAI_MODEL_TTS=gpt-4o-mini-tts

# ─── Google Calendar (read-only) ────────────────────────────────────────────
# OAuth client (type "Web application") with redirect URI
#   ${APP_URL}/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts OAuth tokens at rest (AES-256-GCM). Long random string: `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=

# ─── Notifications ──────────────────────────────────────────────────────────
# Web Push keys: `npx web-push generate-vapid-keys`. The public key is safe to expose.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
# Protects /api/cron/hourly (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# ─── Seed (development only) ────────────────────────────────────────────────
SEED_USER_EMAIL=jhony@lia.local
SEED_USER_PASSWORD=lia-dev-password

# ─── Observability ──────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
